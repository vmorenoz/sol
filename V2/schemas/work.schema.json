{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:sol:v2:work:1",
  "title": "Sol work",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "cycle": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "outcome": {
          "type": "string",
          "minLength": 1
        },
        "criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "verification": {
                "type": "string",
                "minLength": 1
              },
              "contractRevision": {
                "type": "integer",
                "minimum": 1
              },
              "evidenceIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
                },
                "minItems": 0
              }
            },
            "required": [
              "id",
              "description",
              "verification",
              "evidenceIds"
            ]
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "outcome",
        "criteria"
      ]
    },
    "status": {
      "enum": [
        "pending",
        "in_progress",
        "blocked",
        "paused",
        "done",
        "cancelled"
      ]
    },
    "priority": {
      "enum": [
        "low",
        "normal",
        "high",
        "critical"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "string"
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "decisionsPending": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "nextAction": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "work",
              "spec",
              "plan",
              "research",
              "review",
              "decision",
              "delivery",
              "evidence",
              "project"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]:)[^\\u0000]+$"
          },
          "templateVersion": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kind",
          "path",
          "templateVersion"
        ]
      },
      "minItems": 0
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "criterionIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
            },
            "minItems": 1
          },
          "kind": {
            "enum": [
              "research",
              "exploration",
              "specification",
              "planning",
              "implementation",
              "verification",
              "delivery",
              "shipping"
            ]
          },
          "contractRevision": {
            "type": "integer",
            "minimum": 1
          },
          "agent": {
            "anyOf": [
              {
                "enum": [
                  "sol-researcher",
                  "sol-explorer",
                  "sol-planner",
                  "sol-plan-auditor",
                  "sol-executor",
                  "sol-qa-auditor",
                  "sol-security-auditor",
                  "sol-code-reviewer",
                  "sol-ui-auditor"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "pending",
              "in_progress",
              "blocked",
              "paused",
              "done",
              "cancelled"
            ]
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
            },
            "minItems": 0
          },
          "writeScope": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]:)[^\\u0000]+$"
            },
            "minItems": 0
          },
          "resources": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "acceptance": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
            },
            "minItems": 0
          },
          "summary": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "criterionIds",
          "agent",
          "status",
          "dependsOn",
          "writeScope",
          "resources",
          "acceptance",
          "evidenceIds",
          "summary"
        ]
      },
      "minItems": 0
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
          },
          "kind": {
            "enum": [
              "executed",
              "manual",
              "static",
              "not_run"
            ]
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "blocked",
              "not_run"
            ]
          },
          "checkedAt": {
            "type": "string",
            "format": "date-time"
          },
          "criterionIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
            },
            "minItems": 0
          },
          "taskIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
            },
            "minItems": 0
          },
          "report": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]:)[^\\u0000]+$"
          },
          "command": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "cwd": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]:)[^\\u0000]+$"
          },
          "exitCode": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "basis": {
            "type": "string",
            "minLength": 1
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]:)[^\\u0000]+$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "path",
                "sha256"
              ]
            },
            "minItems": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "contractBindings": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "schemaVersion": {
                "const": 1
              },
              "criteria": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
                    },
                    "revision": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  },
                  "required": [
                    "id",
                    "revision",
                    "sha256"
                  ]
                }
              },
              "tasks": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
                    },
                    "revision": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  },
                  "required": [
                    "id",
                    "revision",
                    "sha256"
                  ]
                }
              }
            },
            "required": [
              "schemaVersion",
              "criteria",
              "tasks"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "status",
          "checkedAt",
          "criterionIds",
          "taskIds",
          "report",
          "command",
          "cwd",
          "exitCode",
          "basis",
          "files",
          "summary"
        ]
      },
      "minItems": 0
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "contextLane": {
          "enum": [
            "existing-project",
            "greenfield",
            "project-in-existing-repo",
            "unknown"
          ]
        },
        "sources": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
              },
              "kind": {
                "enum": [
                  "user_statement",
                  "repository",
                  "official_documentation",
                  "existing_document",
                  "runtime_observation",
                  "test_observation",
                  "other"
                ]
              },
              "ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "observedAt": {
                "type": "string",
                "format": "date-time"
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "inspection": {
                "enum": [
                  "found",
                  "read",
                  "contrasted",
                  "stale",
                  "unknown",
                  "absent"
                ]
              },
              "inspectionProvenance": {
                "const": "caller_reported"
              },
              "fileSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "id",
              "kind",
              "ref",
              "observedAt"
            ]
          }
        },
        "claims": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
              },
              "kind": {
                "enum": [
                  "fact",
                  "hypothesis",
                  "recommendation"
                ]
              },
              "statement": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "sourceIds": {
                "type": "array",
                "maxItems": 50,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
                }
              }
            },
            "required": [
              "id",
              "kind",
              "statement",
              "sourceIds"
            ]
          }
        },
        "assumptions": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
              },
              "statement": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "taskIds": {
                "type": "array",
                "maxItems": 50,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
                }
              },
              "criterionIds": {
                "type": "array",
                "maxItems": 50,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
                }
              },
              "impact": {
                "enum": [
                  "material",
                  "non_material"
                ]
              },
              "validation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "status": {
                "enum": [
                  "open",
                  "validated",
                  "rejected"
                ]
              },
              "resolution": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "sourceIds": {
                "type": "array",
                "maxItems": 50,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
                }
              }
            },
            "required": [
              "id",
              "statement",
              "impact",
              "validation",
              "status",
              "sourceIds"
            ]
          }
        },
        "questions": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
              },
              "question": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "whyItMatters": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "taskIds": {
                "type": "array",
                "maxItems": 50,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
                }
              },
              "criterionIds": {
                "type": "array",
                "maxItems": 50,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
                }
              },
              "impact": {
                "enum": [
                  "material",
                  "non_material"
                ]
              },
              "resolutionKind": {
                "enum": [
                  "human_decision",
                  "investigation"
                ]
              },
              "sourceIds": {
                "type": "array",
                "maxItems": 50,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
                }
              },
              "options": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    "consequence": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1000
                    }
                  },
                  "required": [
                    "id",
                    "label",
                    "consequence"
                  ]
                }
              },
              "recommendation": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "optionId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  },
                  "counterpremise": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  }
                },
                "required": [
                  "optionId",
                  "reason",
                  "counterpremise"
                ]
              },
              "answer": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "kind": {
                    "enum": [
                      "investigated",
                      "user_reported",
                      "existing_source"
                    ]
                  },
                  "sourceIds": {
                    "type": "array",
                    "maxItems": 50,
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
                    }
                  },
                  "reportedAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "decisionId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
                  }
                },
                "required": [
                  "text",
                  "kind",
                  "sourceIds",
                  "reportedAt"
                ]
              }
            },
            "required": [
              "id",
              "question",
              "whyItMatters",
              "impact",
              "sourceIds"
            ]
          }
        },
        "decisions": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
              },
              "taskIds": {
                "type": "array",
                "maxItems": 50,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
                }
              },
              "criterionIds": {
                "type": "array",
                "maxItems": 50,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
                }
              },
              "questionIds": {
                "type": "array",
                "maxItems": 50,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
                }
              },
              "statement": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "rationale": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "status": {
                "enum": [
                  "proposed",
                  "confirmed",
                  "superseded"
                ]
              },
              "confirmedBy": {
                "enum": [
                  "user_reported",
                  "project_owner_reported",
                  "existing_source"
                ]
              },
              "confirmedAt": {
                "type": "string",
                "format": "date-time"
              },
              "sourceIds": {
                "type": "array",
                "maxItems": 50,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
                }
              },
              "supersedes": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
              },
              "supersededBy": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
              },
              "supersessionReason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "supersededFrom": {
                "enum": [
                  "proposed",
                  "confirmed"
                ]
              }
            },
            "required": [
              "id",
              "questionIds",
              "statement",
              "status",
              "sourceIds"
            ]
          }
        }
      },
      "required": [
        "schemaVersion",
        "contextLane",
        "sources",
        "claims",
        "assumptions",
        "questions",
        "decisions"
      ]
    },
    "shipping": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "intents": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "schemaVersion": {
                "const": 1
              },
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
              },
              "sourceWorkRevision": {
                "type": "integer",
                "minimum": 1
              },
              "createdAt": {
                "type": "string",
                "format": "date-time"
              },
              "repository": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
              },
              "branch": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "remote": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "base": {
                "type": "string",
                "minLength": 1,
