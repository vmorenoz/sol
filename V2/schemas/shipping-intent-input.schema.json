{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:sol:v2:shipping-intent-input:1",
  "title": "Sol shipping preview input (caller supplied; core stamps revision and digest)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"},
    "createdAt": {"type": "string", "format": "date-time"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "branch": {"type": "string", "minLength": 1, "maxLength": 300},
    "remote": {"type": "string", "minLength": 1, "maxLength": 200},
    "base": {"type": "string", "minLength": 1, "maxLength": 300},
    "title": {"type": "string", "minLength": 1, "maxLength": 300},
    "body": {"type": "string", "maxLength": 10000},
    "commitMessage": {"type": "string", "minLength": 1, "maxLength": 1000},
    "headSha": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
    "diffSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "contentSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "snapshotSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "workScope": {"type": "array", "maxItems": 100, "items": {"type": "string", "minLength": 1}},
    "expectedPaths": {"type": "array", "maxItems": 500, "items": {"type": "string", "minLength": 1}},
    "evidenceIds": {"type": "array", "maxItems": 100, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"}},
    "includedCommitShas": {"type": "array", "maxItems": 100, "items": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"}},
    "actions": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"enum": ["create_commit", "push_branch", "create_pr"]}},
    "status": {"const": "previewed"}
  },
  "required": ["schemaVersion", "id", "createdAt", "repository", "branch", "remote", "base", "title", "body", "commitMessage", "headSha", "diffSha256", "contentSha256", "snapshotSha256", "workScope", "expectedPaths", "evidenceIds", "includedCommitShas", "actions", "status"]
}
