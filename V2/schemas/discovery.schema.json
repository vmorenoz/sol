{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:sol:v2:discovery:1",
  "title": "Sol discovery ledger",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": 1},
    "contextLane": {"enum": ["existing-project", "greenfield", "project-in-existing-repo", "unknown"]},
    "sources": {"type": "array", "maxItems": 200, "items": {"type": "object", "additionalProperties": false, "properties": {
      "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"},
      "kind": {"enum": ["user_statement", "repository", "official_documentation", "existing_document", "runtime_observation", "test_observation", "other"]},
      "ref": {"type": "string", "minLength": 1, "maxLength": 2000},
      "observedAt": {"type": "string", "format": "date-time"},
      "version": {"type": "string", "minLength": 1, "maxLength": 300},
      "path": {"type": "string", "minLength": 1, "maxLength": 1000},
      "inspection": {"enum": ["found", "read", "contrasted", "stale", "unknown", "absent"]},
      "inspectionProvenance": {"const": "caller_reported"},
      "fileSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    }, "required": ["id", "kind", "ref", "observedAt"]}},
    "claims": {"type": "array", "maxItems": 200, "items": {"type": "object", "additionalProperties": false, "properties": {
      "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"},
      "kind": {"enum": ["fact", "hypothesis", "recommendation"]},
      "statement": {"type": "string", "minLength": 1, "maxLength": 2000},
      "sourceIds": {"type": "array", "maxItems": 50, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"}}
    }, "required": ["id", "kind", "statement", "sourceIds"]}},
    "assumptions": {"type": "array", "maxItems": 100, "items": {"type": "object", "additionalProperties": false, "properties": {
      "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"},
      "statement": {"type": "string", "minLength": 1, "maxLength": 2000},
      "impact": {"enum": ["material", "non_material"]},
      "validation": {"type": "string", "minLength": 1, "maxLength": 2000},
      "status": {"enum": ["open", "validated", "rejected"]},
      "resolution": {"type": "string", "minLength": 1, "maxLength": 2000},
      "sourceIds": {"type": "array", "maxItems": 50, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"}}
    }, "required": ["id", "statement", "impact", "validation", "status", "sourceIds"]}},
    "questions": {"type": "array", "maxItems": 100, "items": {"type": "object", "additionalProperties": false, "properties": {
      "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"},
      "question": {"type": "string", "minLength": 1, "maxLength": 2000},
      "whyItMatters": {"type": "string", "minLength": 1, "maxLength": 2000},
      "impact": {"enum": ["material", "non_material"]},
      "resolutionKind": {"enum": ["human_decision", "investigation"]},
      "sourceIds": {"type": "array", "maxItems": 50, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"}},
      "options": {"type": "array", "maxItems": 8, "items": {"type": "object", "additionalProperties": false, "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"},
        "label": {"type": "string", "minLength": 1, "maxLength": 500},
        "consequence": {"type": "string", "minLength": 1, "maxLength": 1000}
      }, "required": ["id", "label", "consequence"]}},
      "recommendation": {"type": "object", "additionalProperties": false, "properties": {
        "optionId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 1000},
        "counterpremise": {"type": "string", "minLength": 1, "maxLength": 1000}
      }, "required": ["optionId", "reason", "counterpremise"]},
      "answer": {"type": "object", "additionalProperties": false, "properties": {
        "text": {"type": "string", "minLength": 1, "maxLength": 2000},
        "kind": {"enum": ["investigated", "user_reported", "existing_source"]},
        "sourceIds": {"type": "array", "maxItems": 50, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"}},
        "reportedAt": {"type": "string", "format": "date-time"},
        "decisionId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"}
      }, "required": ["text", "kind", "sourceIds", "reportedAt"]}
    }, "required": ["id", "question", "whyItMatters", "impact", "sourceIds"]}},
    "decisions": {"type": "array", "maxItems": 100, "items": {"type": "object", "additionalProperties": false, "properties": {
      "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"},
      "questionIds": {"type": "array", "maxItems": 50, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"}},
      "statement": {"type": "string", "minLength": 1, "maxLength": 2000},
      "rationale": {"type": "string", "minLength": 1, "maxLength": 2000},
      "status": {"enum": ["proposed", "confirmed", "superseded"]},
      "confirmedBy": {"enum": ["user_reported", "project_owner_reported", "existing_source"]},
      "confirmedAt": {"type": "string", "format": "date-time"},
      "sourceIds": {"type": "array", "maxItems": 50, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"}},
      "supersedes": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"},
      "supersededBy": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"},
      "supersessionReason": {"type": "string", "minLength": 1, "maxLength": 1000},
      "supersededFrom": {"enum": ["proposed", "confirmed"]}
    }, "required": ["id", "questionIds", "statement", "status", "sourceIds"]}}
  },
  "required": ["schemaVersion", "contextLane", "sources", "claims", "assumptions", "questions", "decisions"]
}
