{
  "name": "sol",
  "version": "2.2.1",
  "private": true,
  "description": "Tools sem\u00e1nticas y orquestaci\u00f3n nativa para OpenCode v2; core local, sin runtime propio.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "install:sol": "node install.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "verify": "node scripts/check.mjs && node --test tests/*.test.mjs",
    "verify:package": "node --test tests/package-payload.test.mjs",
    "uninstall:sol": "node uninstall.mjs"
  },
